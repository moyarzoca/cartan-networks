\begin_layout Standard
- CaNN layer.
 
\end_layout

\begin_layout Standard
A point in a hyperbolic space in our parameterization is
\begin_inset Formula 
\begin{align*}
 & \left(\begin{array}{c}
\Upsilon_{1}\\
\mathbf{\Upsilon}_{2}
\end{array}\right)\in\bR^{1+q}
\end{align*}

\end_inset

We need to build a function that extracts the fiber components 
\begin_inset Formula $\mathbf{\Upsilon}_{2}$
\end_inset

 and the Cartan 
\begin_inset Formula $\Upsilon_{1}$
\end_inset

.
\end_layout

\begin_layout Standard
We need to define a group multiplication 
\begin_inset Formula 
\begin{align*}
\mathtt{group_{-}prod}(\Psi,\Upsilon)=\Psi*\Upsilon & =\left(\begin{array}{c}
\Upsilon_{1}+\Psi_{1}\\
\mathbf{\Upsilon}_{2}+e^{-\Upsilon_{1}}\boldsymbol{\Psi}_{2}
\end{array}\right)\,,\\
\mathtt{group_{-}inv}(\Upsilon)=\Upsilon^{-1} & =\left(\begin{array}{c}
-\Upsilon_{1}\\
-e^{-\Upsilon_{1}}\boldsymbol{\Upsilon}_{2}
\end{array}\right)\,.
\end{align*}

\end_inset


\end_layout

\begin_layout Subsection
Composition of CaNN layer
\end_layout

\begin_layout Standard
A general isometri in 
\begin_inset Formula $q+1$
\end_inset

-dimensional hyperbolic space is
\begin_inset Formula 
\begin{align*}
\varphi_{Q,\beta,u}(\Upsilon) & =R_{u}\left(\beta*\left(\begin{array}{c}
\Upsilon_{1}\\
Q\boldsymbol{\Upsilon}_{2}
\end{array}\right)\right)
\end{align*}

\end_inset

where 
\begin_inset Formula $\beta$
\end_inset

 is a generic constant point in the hyperbolic space,
 
\begin_inset Formula $Q$
\end_inset

 is orthogonal and 
\begin_inset Formula $R_{\boldsymbol{u}}$
\end_inset

 is the fiber rotationg
\begin_inset Formula 
\begin{align}
\mathtt{fiber_{-}rot}(\Upsilon,u)=R_{u}(\Upsilon) & =\left(\begin{array}{c}
-\log\left[\frac{1}{2}\left\{ -u_{0}(A-B)+(A+B)\right\} -\Upsilon_{2}\cdot\boldsymbol{u}'\right]\\
\boldsymbol{\Upsilon}_{2}-\left(\frac{\boldsymbol{\Upsilon}_{2}\cdot\boldsymbol{u}'}{1+u_{0}}+\frac{1}{2}(A-B)\right)\boldsymbol{u}'
\end{array}\right)\,,\\
 & A=e^{\Upsilon_{1}}(1+|\boldsymbol{\Upsilon}_{2}|^{2}),B=e^{-\Upsilon_{1}}\,.
\end{align}

\end_inset


\end_layout

\begin_layout Standard
The map to the next layer is a group homomorphism 
\begin_inset Formula $h:M^{1+q}\to M^{1+p}$
\end_inset

 which is given by
\begin_inset Formula 
\begin{align}
h_{W,\boldsymbol{b}}(\Upsilon) & =\left(\begin{array}{c}
\Upsilon_{1}\\
W\boldsymbol{\Upsilon}_{2}+(1-e^{-\Upsilon_{1}})\boldsymbol{b}
\end{array}\right)\,.
\end{align}

\end_inset


\end_layout

\begin_layout Standard
Let us do 
\begin_inset Formula $(\varphi_{Q,\beta,u}\circ h_{W,b})(\Upsilon)$
\end_inset


\begin_inset Formula 
\begin{align}
R_{u}\left(\beta*\left(\begin{array}{c}
\tilde{\Upsilon}_{1}\\
Q\tilde{\Upsilon}_{2}
\end{array}\right)\right) & =R_{u}\left(\beta*\left(\begin{array}{c}
\Upsilon_{1}\\
QW\boldsymbol{\Upsilon}_{2}+(1-e^{-\Upsilon_{1}})Q\boldsymbol{b}
\end{array}\right)\right)
\end{align}

\end_inset

Now we can redefine the constants 
\begin_inset Formula $\tilde{\boldsymbol{b}}=Q\boldsymbol{b}$
\end_inset

 and 
\begin_inset Formula $\tilde{W}=QW$
\end_inset

.
 Therefore,
 the layer composition function is
\begin_inset Formula 
\begin{align}
\mathtt{cann_{-}layermap}(\Upsilon;u,W,b,\beta)\equiv L_{u,W,\boldsymbol{b},\beta}(\Upsilon) & =R_{u}\left(\beta*\left(\begin{array}{c}
\Upsilon_{1}\\
W\boldsymbol{\Upsilon}_{2}+(1-e^{-\Upsilon_{1}})\boldsymbol{b}
\end{array}\right)\right)\,.
\end{align}

\end_inset


\end_layout

